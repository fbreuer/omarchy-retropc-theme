{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "RetroPC",
  "author": "Ron Dilley; Zed adaptation by repository contributors",
  "themes": [
    {
      "name": "RetroPC",
      "appearance": "dark",
      "style": {
        "background": "#0A0A08",
        "surface.background": "#0F0E0A",
        "elevated_surface.background": "#1A1612",
        "panel.background": "#0A0A08",
        "title_bar.background": "#0A0A08",
        "title_bar.inactive_background": "#0A0A08",
        "toolbar.background": "#0F0E0A",
        "status_bar.background": "#1A1612",
        "tab_bar.background": "#0A0A08",
        "tab.active_background": "#1A1612",
        "tab.inactive_background": "#0A0A08",

        "border": "#805500",
        "border.variant": "#2A1F00",
        "border.focused": "#FFB000",
        "border.selected": "#FFCC00",
        "border.disabled": "#2A1F00",
        "border.transparent": "#00000000",
        "pane.focused_border": "#996600",
        "pane_group.border": "#2A1F00",
        "panel.focused_border": "#996600",

        "text": "#FFB000",
        "text.muted": "#996600",
        "text.placeholder": "#805500",
        "text.disabled": "#805500",
        "text.accent": "#FFCC00",
        "icon": "#CC9900",
        "icon.muted": "#996600",
        "icon.disabled": "#805500",
        "icon.placeholder": "#805500",
        "icon.accent": "#FFCC00",
        "link_text.hover": "#FFDD00",

        "element.background": "#1A1612",
        "element.hover": "#2A1F00",
        "element.active": "#392B00",
        "element.selected": "#2A1F00",
        "element.disabled": "#0F0E0A",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#2A1F00",
        "ghost_element.active": "#392B00",
        "ghost_element.selected": "#2A1F00",
        "ghost_element.disabled": "#0A0A08",
        "drop_target.background": "#FFCC0026",

        "editor.background": "#0A0A08",
        "editor.foreground": "#FFB000",
        "editor.gutter.background": "#0A0A08",
        "editor.subheader.background": "#0F0E0A",
        "editor.active_line.background": "#1A1612",
        "editor.highlighted_line.background": "#2A1F0080",
        "editor.line_number": "#805500",
        "editor.active_line_number": "#FFCC00",
        "editor.invisible": "#805500",
        "editor.indent_guide": "#2A1F00",
        "editor.indent_guide_active": "#805500",
        "editor.wrap_guide": "#2A1F00",
        "editor.active_wrap_guide": "#805500",
        "editor.document_highlight.read_background": "#2A1F00",
        "editor.document_highlight.write_background": "#4A3300",
        "editor.document_highlight.bracket_background": "#80550066",
        "search.match_background": "#80550080",

        "panel.indent_guide": "#2A1F00",
        "panel.indent_guide_hover": "#805500",
        "panel.indent_guide_active": "#FFB000",
        "scrollbar.track.background": "#0A0A0800",
        "scrollbar.track.border": "#00000000",
        "scrollbar.thumb.background": "#80550066",
        "scrollbar.thumb.hover_background": "#99660099",
        "scrollbar.thumb.border": "#00000000",

        "error": "#FF6600",
        "error.background": "#FF66001A",
        "error.border": "#FF6600",
        "warning": "#FF8800",
        "warning.background": "#FF88001A",
        "warning.border": "#FF8800",
        "info": "#FFAA00",
        "info.background": "#FFAA001A",
        "info.border": "#FFAA00",
        "hint": "#FF9900",
        "hint.background": "#FF99001A",
        "hint.border": "#FF9900",
        "success": "#D4AA00",
        "success.background": "#D4AA001A",
        "success.border": "#D4AA00",
        "created": "#D4AA00",
        "modified": "#FFCC00",
        "deleted": "#FF6600",
        "renamed": "#FFAA00",
        "conflict": "#FF8800",
        "ignored": "#805500",
        "hidden": "#805500",
        "predictive": "#996600",
        "unreachable": "#805500",

        "accents": [
          "#FFB000",
          "#FF8800",
          "#FFCC00",
          "#CC9900",
          "#FF9900",
          "#FFAA00",
          "#D4AA00"
        ],
        "players": [
          {
            "cursor": "#FFCC00",
            "selection": "#FFCC0033",
            "background": "#2A1F00"
          }
        ],

        "terminal.background": "#0A0A08",
        "terminal.foreground": "#FFB000",
        "terminal.bright_foreground": "#FFCC00",
        "terminal.dim_foreground": "#996600",
        "terminal.ansi.background": "#0A0A08",
        "terminal.ansi.black": "#2A1F00",
        "terminal.ansi.red": "#FF8800",
        "terminal.ansi.green": "#FFCC00",
        "terminal.ansi.yellow": "#FFD700",
        "terminal.ansi.blue": "#CC9900",
        "terminal.ansi.magenta": "#FF9900",
        "terminal.ansi.cyan": "#CC9900",
        "terminal.ansi.white": "#D4AA00",
        "terminal.ansi.bright_black": "#805500",
        "terminal.ansi.bright_red": "#FFAA00",
        "terminal.ansi.bright_green": "#FFCC00",
        "terminal.ansi.bright_yellow": "#FFDD00",
        "terminal.ansi.bright_blue": "#FFBB00",
        "terminal.ansi.bright_magenta": "#FFAA00",
        "terminal.ansi.bright_cyan": "#FFB000",
        "terminal.ansi.bright_white": "#FFCC00",

        "syntax": {
          "attribute": { "color": "#FFB000" },
          "boolean": { "color": "#FFBB00" },
          "comment": { "color": "#805500", "font_style": "italic" },
          "comment.doc": { "color": "#996600", "font_style": "italic" },
          "constant": { "color": "#FFCC00" },
          "constructor": { "color": "#FFBB00", "font_weight": 700 },
          "embedded": { "color": "#CC9900" },
          "emphasis": { "color": "#FFCC00", "font_style": "italic" },
          "emphasis.strong": { "color": "#FFCC00", "font_weight": 700 },
          "enum": { "color": "#D4AA00" },
          "function": { "color": "#FFBB00", "font_weight": 700 },
          "function.builtin": { "color": "#FFCC00", "font_weight": 700 },
          "hint": { "color": "#FF9900" },
          "keyword": { "color": "#FF8800", "font_weight": 700 },
          "label": { "color": "#FFAA00" },
          "link_text": { "color": "#FFCC00" },
          "link_uri": { "color": "#CC9900", "font_style": "italic" },
          "number": { "color": "#FFBB00" },
          "operator": { "color": "#FFCC00" },
          "predictive": { "color": "#996600", "font_style": "italic" },
          "preproc": { "color": "#FF9900" },
          "primary": { "color": "#FFB000" },
          "property": { "color": "#FFB000" },
          "punctuation": { "color": "#CC9900" },
          "punctuation.bracket": { "color": "#D4AA00" },
          "punctuation.delimiter": { "color": "#CC9900" },
          "punctuation.list_marker": { "color": "#FFAA00" },
          "punctuation.special": { "color": "#FF9900" },
          "string": { "color": "#FFAA00" },
          "string.escape": { "color": "#FFCC00" },
          "string.regex": { "color": "#FF9900" },
          "string.special": { "color": "#FFBB00" },
          "tag": { "color": "#FF8800", "font_weight": 700 },
          "text.literal": { "color": "#FFAA00" },
          "title": { "color": "#FFCC00", "font_weight": 700 },
          "type": { "color": "#CC9900" },
          "variable": { "color": "#FFB000" },
          "variable.builtin": { "color": "#FFCC00" },
          "variable.parameter": { "color": "#FFAA00", "font_style": "italic" },
          "variant": { "color": "#D4AA00" }
        }
      }
    }
  ]
}
