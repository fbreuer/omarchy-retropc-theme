    "editor.lineHighlightBackground": "#1A1612",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#2A1F00",
    "editorIndentGuide.background1": "#2A1F00",
    "editorIndentGuide.activeBackground1": "#805500",
    "editorRuler.foreground": "#2A1F00",
