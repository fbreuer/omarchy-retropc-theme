    "terminal.ansiBrightRed": "#FFAA00",
    "terminal.ansiBrightGreen": "#FFCC00",
    "terminal.ansiBrightYellow": "#FFDD00",
    "terminal.ansiBrightBlue": "#FFBB00",
    "terminal.ansiBrightMagenta": "#FFAA00",
    "terminal.ansiBrightCyan": "#FFB000",
