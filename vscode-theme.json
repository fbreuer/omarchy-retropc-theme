    "notifications.border": "#805500",
    "notificationLink.foreground": "#FFCC00",
    "quickInput.background": "#1A1612",
    "quickInput.foreground": "#FFB000",
    "quickInputList.focusBackground": "#2A1F00",
    "quickInputList.focusForeground": "#FFCC00",
    "commandCenter.background": "#1A1612",
    "commandCenter.foreground": "#FFB000",
    "commandCenter.border": "#805500",
    "menu.background": "#1A1612",
    "menu.foreground": "#FFB000",
    "menu.selectionBackground": "#2A1F00",
    "menu.selectionForeground": "#FFCC00",
    "menu.separatorBackground": "#805500",
    "menu.border": "#805500"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#805500", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#FF8800", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#FFBB00", "fontStyle": "bold" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#FFAA00" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#FFBB00" }
    },
    {
      "scope": ["keyword.operator", "constant.other.color", "punctuation.separator"],
      "settings": { "foreground": "#FFCC00" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "support.type", "support.class"],
      "settings": { "foreground": "#CC9900" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF8800", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.other.attribute-name", "variable.other.property"],
      "settings": { "foreground": "#FFB000" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#FFAA00", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": { "foreground": "#FFB000" }
    },
    {
      "scope": ["constant", "variable.language", "support.constant"],
      "settings": { "foreground": "#FFCC00" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#CC9900" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#FFCC00", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FFCC00", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#FFB000", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#CC9900", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#000000", "background": "#FF6600" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": { "foreground": "#805500", "italic": true },
    "keyword": { "foreground": "#FF8800", "bold": true },
    "function": { "foreground": "#FFBB00", "bold": true },
    "method": "#FFBB00",
    "macro": "#FF9900",
    "string": "#FFAA00",
    "number": "#FFBB00",
    "operator": "#FFCC00",
    "type": "#CC9900",
    "class": "#D4AA00",
    "enum": "#D4AA00",
    "interface": "#CC9900",
    "typeParameter": "#FFAA00",
    "parameter": { "foreground": "#FFAA00", "italic": true },
    "property": "#FFB000",
    "variable": "#FFB000",
    "variable.readonly": "#FFCC00",
    "enumMember": "#FFCC00",
    "namespace": "#D4AA00",
    "decorator": "#FF9900"
  }
}
